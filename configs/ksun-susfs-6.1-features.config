# Isolated KSUN + kernel-patched SUSFS + BBG + NoMount candidate.
# Fresh O= directory; no shared features.config or old LTO cache.
CONFIG_ARM64=y
CONFIG_KPROBES=y
CONFIG_THREAD_INFO_IN_TASK=y
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_BBG=y
# CONFIG_BBG_BLOCK_BOOT is not set
# CONFIG_BBG_BLOCK_RECOVERY is not set
CONFIG_NOMOUNT=y
CONFIG_KEYS=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor,bpf,baseband_guard"
# CONFIG_LTO_NONE is not set
# CONFIG_LTO_CLANG_THIN is not set
CONFIG_LTO_CLANG_FULL=y
CONFIG_CFI_CLANG=y
# CONFIG_NTSYNC is not set
