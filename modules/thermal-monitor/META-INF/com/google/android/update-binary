#!/sbin/sh
# Magisk installer entry; KernelSU, KernelSU Next and BakaSU run customize.sh themselves.
umask 022
OUTFD=$2
ZIPFILE=$3
ui_print() { echo "$1"; }
mount /data 2>/dev/null
if [ ! -f /data/adb/magisk/util_functions.sh ]; then
  ui_print "! Install from KernelSU / KernelSU Next / BakaSU / Magisk"
  exit 1
fi
. /data/adb/magisk/util_functions.sh
install_module
exit 0
